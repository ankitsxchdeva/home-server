# HTTP Basic auth password for the guest page (any username works).
# No default: the app refuses all logins when unset. The real value lives
# only on the Pi — this repo is public.
PARK_PASSWORD=

# Server-side defaults for the optional visitor fields
GUEST_NAME=
GUEST_PHONE=
GUEST_EMAIL=

# Registration target (mirror autovrr/.env)
APARTMENT_NAME=
ACCESS_CODE=
UNIT_NUMBER=
RESIDENT_NAME=
