# Cloudflare API token for the DNS-01 ACME challenge (wildcard *.ankit.casa cert).
# Needs Zone:DNS:Edit on the ankit.casa zone.
CF_API_TOKEN=your_cloudflare_api_token_here

# Mac Studio Ollama upstream for ollama.ankit.casa — the Studio's Tailscale
# IP:port (e.g. 100.x.y.z:11434). Until set, that route 502s by design.
# OLLAMA_UPSTREAM=

# Unguessable public path for the guest parking page: the Caddyfile :8089
# block (funnel :10000) routes /THIS_PATH → autovrr:8003. No leading slash.
# Fail-closed: unset → the park page is not routed publicly at all.
# PARK_PUBLIC_PATH=
