# One wildcard Let's Encrypt cert (DNS-01 via Cloudflare — no public exposure).
# ankit.casa and *.ankit.casa resolve to the Pi's Tailscale IP: tailnet-only.
# Bridge-network services are proxied by container name; host-network
# services (home-assistant, netalertx, cups) via $LAN_IP (default below,
# override in caddy/.env).
ankit.casa, *.ankit.casa {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@ha host ha.ankit.casa
	handle @ha {
		reverse_proxy {$LAN_IP:192.168.1.102}:8123
	}

	@kuma host kuma.ankit.casa
	handle @kuma {
		reverse_proxy uptime-kuma:3001
	}

	@glances host glances.ankit.casa
	handle @glances {
		reverse_proxy glances:61208
	}

	@netalertx host netalertx.ankit.casa
	handle @netalertx {
		reverse_proxy {$LAN_IP:192.168.1.102}:20211
	}

	@cups host cups.ankit.casa
	handle @cups {
		reverse_proxy {$LAN_IP:192.168.1.102}:631
	}

	@thirteenft host 13ft.ankit.casa
	handle @thirteenft {
		reverse_proxy 13ft:5000
	}

	@rss host rss.ankit.casa
	handle @rss {
		reverse_proxy rss-reader:8000
	}

	@kalshi host kalshi.ankit.casa
	handle @kalshi {
		reverse_proxy kalshi-pnl:8000
	}

	@quantlab host quantlab.ankit.casa
	handle @quantlab {
		reverse_proxy quantlab:3000
	}

	@dozzle host logs.ankit.casa
	handle @dozzle {
		reverse_proxy dozzle:8080
	}

	@diagram host diagram.ankit.casa
	handle @diagram {
		reverse_proxy diagram:80
	}

	# Ollama runs natively on the Mac Studio now (see studio-llm repo) — no
	# auth of its own; the tailnet (ankit.casa -> Tailscale IP) is the boundary.
	# OLLAMA_UPSTREAM = the Studio's Tailscale IP:port, set in caddy/.env
	# (host-only, gitignored). Until set, this route 502s by design.
	@ollama host ollama.ankit.casa
	handle @ollama {
		reverse_proxy {$OLLAMA_UPSTREAM:studio-unset.invalid:11434}
	}

	@park host park.ankit.casa
	handle @park {
		reverse_proxy autovrr:8003
	}

	# default: the dashboard
	handle {
		reverse_proxy homepage:3000
	}
}

# ── Public front door ────────────────────────────────────────────────
# The single Tailscale Funnel mount (host state, static — see RESTORE.md)
# terminates TLS and proxies :10000 → 8089. ALL public routing lives in this
# block; the funnel mount never changes. Prefix-stripping happens HERE
# (handle_path), not in tailscaled, so it is visible and versioned. Matching
# is by specificity (longest path first), not file order. Published on
# 127.0.0.1 only (see compose) — unreachable from the LAN.
:8089 {
	# Guest parking page at an unguessable path. PARK_PUBLIC_PATH lives in
	# caddy/.env (gitignored, backed up); unset → matches nothing (fail-closed).
	handle_path /{$PARK_PUBLIC_PATH:__unset__}* {
		reverse_proxy autovrr:8003
	}

	# rss-reader (lede digest API)
	handle_path /lede* {
		reverse_proxy rss-reader:8000
	}

	handle_path /quantlab* {
		reverse_proxy quantlab:3000
	}

	# default: kalshi-pnl (public pnl number)
	handle {
		reverse_proxy kalshi-pnl:8000
	}
}
