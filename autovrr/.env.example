# ===========================================
# Discord Bot Configuration
# ===========================================
DISCORD_TOKEN=
GUILD_ID=your_guild_id_here

# ===========================================
# VRR Parking - Apartment Configuration
# ===========================================
APARTMENT_NAME=
ACCESS_CODE=

# ===========================================
# Personal Details (Resident Information)
# ===========================================
RESIDENT_NAME=
UNIT_NUMBER=

# ===========================================
# Visitor Details
# ===========================================
VISITOR_NAME=
VISITOR_PHONE=
VISITOR_EMAIL=

# ===========================================
# Default Vehicle (for /quickpark command)
# ===========================================
DEFAULT_LICENSE_PLATE=
DEFAULT_VEHICLE_MAKE=
DEFAULT_VEHICLE_MODEL=

# ===========================================
# Guest parking web page (web.py, port 8003)
# ===========================================
# HTTP Basic auth password (any username). No default: the page refuses all
# logins when unset. The real value lives only on the Pi — repo is public.
PARK_PASSWORD=

# Server-side defaults for the optional visitor fields
GUEST_NAME=
GUEST_PHONE=
GUEST_EMAIL=
