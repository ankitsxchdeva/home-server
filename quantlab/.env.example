# Ollama endpoint override (code default: https://ollama.ankit.casa/v1).
# Point DIRECTLY at the Studio instead: >60s buffered requests (muse-glimmer
# compiles) die on the container -> caddy hairpin path (found 2026-10-05).
OLLAMA_BASE_URL=http://STUDIO_TAILSCALE_IP:11434/v1
# Model pin (server-side, anti-probe) and bearer for servers that enforce one.
OLLAMA_MODEL=muse-glimmer:30b-q4_K_M
OLLAMA_API_KEY=ollama
