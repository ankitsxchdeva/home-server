# LLM endpoint override (code default: https://ollama.ankit.casa/v1).
# Point DIRECTLY at oMLX on the Studio instead: >60s buffered requests
# (strategy compiles) die on the container -> caddy hairpin path (found 2026-10-05).
OLLAMA_BASE_URL=http://STUDIO_TAILSCALE_IP:8000/v1
# Model pin (server-side, anti-probe) and the oMLX bearer key.
OLLAMA_MODEL=Muse-Glimmer-30B-MLX-4bit
OLLAMA_API_KEY=replace-me-omlx-key
