POSTGRES_PASSWORD=change-me-generate-a-real-one
JWT_SECRET=change-me-generate-a-long-random-string
TZ=America/Chicago
# Cloudflare dashboard → Zero Trust → Networks → Tunnels → nurv-api → token
TUNNEL_TOKEN=change-me
# Password-reset email (https://resend.com). Unset = reset emails never send.
RESEND_API_KEY=re_change-me
EMAIL_FROM="Nurv <noreply@nurv.space>"
APP_URL=https://nurv.space
# Comma-separated emails allowed to moderate community posts/reports.
ADMIN_EMAILS=
