# How often to rebuild the digest
POLL_INTERVAL_SECONDS=1800

# Which origin may fetch data.json (the Pages site). Use * to allow anyone.
ALLOW_ORIGIN=https://ankitsachdeva.com

# "Today" for the digest window: only items published since midnight in this
# timezone are kept
DIGEST_TZ=America/Chicago

# Be a polite bot
USER_AGENT=lede/1.0 (+https://ankitsachdeva.com/lede)

# Shared secret for the saved/read-later write endpoints (the funnel URL is
# public). The frontend asks for it once and keeps it in localStorage.
# Leave empty to allow writes from anyone.
SAVE_TOKEN=

# Optional: route sources marked `paywall: true` through the existing 13ft proxy.
# Compose `include:` puts every service on one network, so use the service name:
# PAYWALL_PROXY=http://13ft:5000

# Optional: timezone for log timestamps, defaults to UTC
#TZ=America/Chicago

# --- LLM summarization (local Ollama, internal network only) ---
# Base URL of the shared Ollama service. No host port is published; it is
# Ollama — runs natively on the Mac Studio (Metal), reached through Caddy on
# the Pi. Point at the Caddy route, not a host:
OLLAMA_URL=https://ollama.ankit.casa
# Model for per-item summaries and the daily themes overview.
# Whatever model the Studio is serving (see studio-llm repo). qwen2.5:3b is
# kept pulled there as the compatibility default.
OLLAMA_MODEL=qwen2.5:3b
# Per-request timeout (seconds) for a single Ollama call. Sized for the slower
# 3b model's themes call (~200 tokens); the circuit breaker still bounds total
# time if Ollama actually hangs.
OLLAMA_TIMEOUT=90
# How long Ollama keeps the model resident after a call, so idle RAM returns
# to the rest of the Pi (Home Assistant et al.).
OLLAMA_KEEP_ALIVE=10m
# Master switch: 0 disables the LLM entirely -> plain truncated summaries.
SUMMARY_ENABLED=1
# Cap on model calls per build cycle; a large backlog of new items spills into
# later cycles instead of blowing the build window.
SUMMARY_MAX_PER_CYCLE=50
# Consecutive failures before the breaker trips and the rest of the cycle falls
# back to truncated summaries.
SUMMARY_BREAKER_THRESHOLD=3
