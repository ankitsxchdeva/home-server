# Copy to .env and fill in. Create an API key at kalshi.com -> Account -> API Keys.
KALSHI_API_KEY_ID=your-key-id-here
# Path to the RSA private key PEM you downloaded when creating the key
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
# Optional override
# KALSHI_BASE_URL=https://api.elections.kalshi.com
