# Open WebUI — chat UI for the Studio's Ollama (see README).
# WEBUI_SECRET_KEY: generate on the Pi with `openssl rand -hex 32`;
# it stays in this gitignored .env, covered by scripts/backup.sh.
OLLAMA_BASE_URL=https://ollama.ankit.casa
WEBUI_SECRET_KEY=replace-me-openssl-rand-hex-32
TZ=America/Chicago
