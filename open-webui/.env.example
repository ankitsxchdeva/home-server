# Open WebUI — chat UI for the Studio's Ollama (see README).
# WEBUI_SECRET_KEY: generate on the Pi with `openssl rand -hex 32`;
# it stays in this gitignored .env, covered by scripts/backup.sh.
# Direct to the Studio (NOT https://ollama.ankit.casa): >60s requests die on
# the container -> caddy hairpin path (found 2026-10-05). No /v1 suffix —
# Open WebUI talks to the native Ollama API.
OLLAMA_BASE_URL=http://STUDIO_TAILSCALE_IP:11434
WEBUI_SECRET_KEY=replace-me-openssl-rand-hex-32
TZ=America/Chicago
