# Open WebUI — chat UI for the Studio's oMLX server (see README).
# WEBUI_SECRET_KEY: generate on the Pi with `openssl rand -hex 32`;
# it stays in this gitignored .env, covered by scripts/backup.sh.
# These seed first boot only; afterwards webui.db (Admin > Settings >
# Connections) wins and edits here are ignored.
# Direct to the Studio (NOT https://ollama.ankit.casa): >60s requests die on
# the container -> caddy hairpin path (found 2026-10-05).
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URL=http://STUDIO_TAILSCALE_IP:8000/v1
OPENAI_API_KEY=replace-me-omlx-key
WEBUI_SECRET_KEY=replace-me-openssl-rand-hex-32
TZ=America/Chicago
